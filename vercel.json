{
  "version": 2,
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "server/**",
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
      ]
    },
    {
      "source": "/results(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/youtube-stats", "destination": "/api/youtube-stats.ts" },
    { "source": "/api/instagram-stats", "destination": "/api/instagram-stats.ts" },
    { "source": "/api/media-kit", "destination": "/api/media-kit.ts" },
    { "source": "/api/brands/ranking", "destination": "/api/brands/ranking.ts" },
    { "source": "/brands/ranking", "destination": "/api/brands/ranking.ts" },
    { "source": "/api/brands", "destination": "/api/brands.ts" },
    { "source": "/brands", "destination": "/api/brands.ts" },
    { "source": "/api/results/sync", "destination": "/api/results/sync.ts" },
    { "source": "/api/results/status", "destination": "/api/results/status.ts" },
    { "source": "/api/results(.*)", "destination": "/api/results.ts" },
    { "source": "/results/sync", "destination": "/api/results/sync.ts" },
    { "source": "/results/status", "destination": "/api/results/status.ts" },
    { "source": "/results(.*)", "destination": "/api/results.ts" },
    { "source": "/((?!api/|results|brands).*)", "destination": "/index.html" }
  ]
}
